# Sandbox guardrails for: {{title}}
# Generated by the api-to-sandbox skill. These are SECURITY LIMITS, not defaults
# to relax casually. run.sh maps them to real `docker run` flags.

runtime:
  # 1) Timeout — kill a run that hangs or loops forever.
  timeout_seconds: {{timeout}}
  # 2) Resource caps — no single learner can starve the host.
  cpus: "{{cpus}}"
  memory: "{{memory}}"
  disk: "{{disk}}"

network:
  # 3) Egress allowlist — the sandbox may ONLY reach the API's own hosts.
  # Default-deny everything else so the box can't become someone's free miner.
  default: deny
  egress_allowlist:
{{allowlist}}

filesystem:
  read_only_root: true          # code can't tamper with the image
  writable_paths:
    - /tmp/work                 # scratch only, wiped on teardown

user:
  non_root: true                # never run as root
  uid: 1000

hardening:
  no_new_privileges: true
  drop_capabilities: ["ALL"]

lifecycle:
  ephemeral: true               # destroy the container after the session
  max_session_minutes: 30
